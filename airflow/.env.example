# Copy to airflow/.env and fill in. Do NOT wrap values in quotes (docker env files keep them).


# ---- AWS: use the mounted CLI profile
AWS_SHARED_CREDENTIALS_FILE=/usr/local/airflow/aws/credentials
AWS_CONFIG_FILE=/usr/local/airflow/aws/config
AWS_DEFAULT_REGION=us-east-1
AIRFLOW_CONN_AWS_DEFAULT={"conn_type": "aws", "extra": {"region_name": "us-east-1"}}

# ---- Snowflake (key-pair auth as the pipeline service user)
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=svc_fdic_pipeline
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/keys/fdic_svc_rsa_key.p8
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type": "snowflake", "login": "svc_fdic_pipeline", "extra": {"account": "<orgname-accountname>", "warehouse": "fdic_wh", "database": "fdic", "role": "fdic_loader", "authenticator": "SNOWFLAKE_JWT", "private_key_file": "/usr/local/airflow/keys/fdic_svc_rsa_key.p8"}}

# ---- Airflow Variables
AIRFLOW_VAR_FDIC_LAMBDA_FUNCTION=fdic-extract
AIRFLOW_VAR_FDIC_ALERT_SNS_TOPIC_ARN=
